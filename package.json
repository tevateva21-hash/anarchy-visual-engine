{
  "name": "anarchy-visual-engine",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @anarchy/studio dev",
